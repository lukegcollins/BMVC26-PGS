+def _slerp_augmentation(zr: torch.Tensor, zf: torch.Tensor, multiplier: int = 1) -> torch.Tensor:
+    """Paired SLERP points on the great-circle arc between aligned real/fake embeddings.
+
+    SLERP(z_r, z_f, tau) = sin((1-tau)W)/sin(W) z_r + sin(tau W)/sin(W) z_f, tau ~ U(0,1), W the
+    geodesic angle; ``multiplier`` draws per pair. These are appended to the uniformity set (BMVC
+    method, eq. slerp). Restored 2026-09-29: deleted in the 2026-03-11 cleanup (d73d1689) while the
+    ``use_paired_slerp_aug`` flag survived, so runs between those dates had SLERP inactive.
+    """
+    P = min(zr.shape[0], zf.shape[0])
+    if P < 1 or multiplier < 1:
+        return zr.new_zeros(0, zr.shape[-1])
+    zr_p, zf_p = zr[:P], zf[:P]
+    dot = (zr_p * zf_p).sum(dim=1, keepdim=True).clamp(-1.0 + _ACOS_EPS, 1.0 - _ACOS_EPS)
+    omega = torch.acos(dot)
+    sin_omega = torch.sin(omega).clamp_min(_EPS)
+    points = []
+    for _ in range(multiplier):
+        tau = torch.rand(P, 1, device=zr.device, dtype=zr.dtype)
+        interp = (torch.sin((1.0 - tau) * omega) / sin_omega) * zr_p + (torch.sin(tau * omega) / sin_omega) * zf_p
+        points.append(_safe_normalize(interp, dim=1))
+    return torch.cat(points, dim=0)
+
